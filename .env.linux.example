# Copy to /etc/market-spread-monitor.env for systemd, or .env.linux for npm run start:linux.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_USERNAME=admin
# Set a unique password of at least 12 characters before starting.
APP_PASSWORD=
# systemd creates and owns this directory via StateDirectory.
ALERT_DATA_DIR=/var/lib/market-spread-monitor
# Oil monitor: optional Feishu bot; Hynix bot is configured in its dashboard.
OIL_FEISHU_WEBHOOK_URL=
OIL_FEISHU_WEBHOOK_SECRET=
OIL_POLL_INTERVAL_SECONDS=30
